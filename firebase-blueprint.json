{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student entity in the academy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "code": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "gender": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "parentId": { "type": "string" },
        "parentNameAr": { "type": "string" },
        "grade": { "type": "string" },
        "status": { "type": "string" },
        "balance": { "type": "number" },
        "remainingSessions": { "type": "number" },
        "totalSessionsCompleted": { "type": "number" },
        "packageId": { "type": "string" },
        "packageNameAr": { "type": "string" },
        "assignedTeacherId": { "type": "string" },
        "assignedTeacherNameAr": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["tenantId", "nameAr", "phone"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "code": { "type": "string" },
        "nameAr": { "type": "string" },
        "nameEn": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "hourlyRate": { "type": "number" },
        "perSessionRate": { "type": "number" },
        "status": { "type": "string" },
        "totalEarned": { "type": "number" },
        "completedSessionsCount": { "type": "number" },
        "rating": { "type": "number" },
        "joinedDate": { "type": "string" }
      },
      "required": ["tenantId", "nameAr"]
    },
    "Parent": {
      "title": "Parent",
      "description": "Parent entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "code": { "type": "string" },
        "nameAr": { "type": "string" },
        "phone": { "type": "string" },
        "whatsapp": { "type": "string" },
        "email": { "type": "string" },
        "totalDue": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["tenantId", "nameAr"]
    },
    "ScheduledSession": {
      "title": "ScheduledSession",
      "description": "Scheduled session or lesson",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "code": { "type": "string" },
        "courseId": { "type": "string" },
        "subjectNameAr": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherNameAr": { "type": "string" },
        "studentId": { "type": "string" },
        "studentNameAr": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["tenantId", "teacherId", "studentId", "date"]
    },
    "PaymentInvoice": {
      "title": "PaymentInvoice",
      "description": "Financial invoice",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tenantId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "studentId": { "type": "string" },
        "studentNameAr": { "type": "string" },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["tenantId", "studentId", "amount"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Collection of students"
    },
    "/teachers/{teacherId}": {
      "schema": { "$ref": "#/entities/Teacher" },
      "description": "Collection of teachers"
    },
    "/parents/{parentId}": {
      "schema": { "$ref": "#/entities/Parent" },
      "description": "Collection of parents"
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ScheduledSession" },
      "description": "Collection of scheduled sessions"
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/PaymentInvoice" },
      "description": "Collection of invoices"
    }
  }
}
